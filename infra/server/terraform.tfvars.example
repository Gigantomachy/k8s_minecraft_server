# Copy to terraform.tfvars (gitignored) and fill in.

aws_region = "ca-central-1"
# aws_profile = "default"

instance_type = "t3.medium"
architecture  = "x86_64"
cpu_credits   = "standard"

# Optional SSH. Leave both commented out to keep port 22 closed and use SSM.
# ssh_allowed_cidr = "203.0.113.10/32"   # your public IP + /32
# ssh_public_key   = "ssh-ed25519 AAAA... you@laptop"

minecraft_version = "LATEST"
memory            = "2G"
whitelist         = ["YourMinecraftName", "FriendName"]
ops               = ["YourMinecraftName"]
motd              = "k8s-minecraft"
